<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CrownforgeTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/crownforge_gold</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@drawable/crownforge_launch</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/crownforge_night</item>
        <item name="android:navigationBarColor">@color/crownforge_night</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSplashScreenBackground">@color/crownforge_night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/crownforge_night</item>
    </style>
</resources>
