; Engine configuration file.
; E-Sport Empire - mobile-first esports management game.

config_version=5

[application]

config/name="E-Sport Empire"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.018, 0.027, 0.067, 1)
config/icon="res://assets/icon.svg"

[display]

window/size/viewport_width=450
window/size/viewport_height=900
window/size/window_width_override=450
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[gui]

common/default_scroll_deadzone=8
common/snap_controls_to_pixels=true
theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=true

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194309,"unicode":13), Object(InputEventKey,"physical_keycode":32,"unicode":32)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.018, 0.027, 0.067, 1)
